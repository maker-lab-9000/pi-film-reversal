[Unit]
Description=pi-film-reversal remote capture service (headless Stick-only mode)
After=network-online.target
Wants=network-online.target
# The camera can take a few seconds to enumerate after boot; without this,
# systemd stops retrying after five quick failures.
StartLimitIntervalSec=0

[Service]
Type=simple
User=george
WorkingDirectory=/home/george/repos/pi-film-reversal
# Without this, Python block-buffers stdout when it isn't a tty, and the
# service's start-up lines never reach the journal.
Environment=PYTHONUNBUFFERED=1
# /etc/pifilm-capture.env is root-owned, mode 600, and holds PIFILM_REMOTE_TOKEN.
EnvironmentFile=/etc/pifilm-capture.env
# Bind on all interfaces: the Stick arrives over the Pi's own hotspot
# (10.42.0.1), while administration arrives over Ethernet. Binding to the
# hotspot address alone races NetworkManager bringing it up at boot.
# --artifacts names the look. pifilm/data is the bundled untrained starter that
# ships with the package and exists in every checkout. To deploy a trained
# model, point this at its directory (params.json + pifilm.cube), for example
# /home/george/repos/pi-film-reversal/artifacts/personal-collection-01-v1,
# and use the same path for PI_ARTIFACT_DIR in .env.
# --ups x728 reads the Geekworm X728 fuel gauge for the Stick's Pi-battery badge; drop it on a Pi without the shield.
# --display waveshare28 runs the LCD viewfinder; on a Pi without the panel the service logs a warning and continues for the Stick.
ExecStart=/home/george/repos/pi-film-reversal/.venv/bin/pifilm-capture --no-preview --remote-listen 0.0.0.0:8765 --artifacts /home/george/repos/pi-film-reversal/pifilm/data --ups x728 --display waveshare28
Restart=on-failure
RestartSec=3
StandardInput=null

[Install]
WantedBy=multi-user.target
