# Local-only values for scripts/deploy_remote.py, scripts/pi_hotspot.py and the
# StickS3 build script. Do not commit a real .env file.
#
# Topology: the Pi runs its own Wi-Fi hotspot and the Stick joins it directly.
# Administration (SSH, photo transfer) goes over Ethernet.

# Where SSH goes. With avahi on the Pi this is the mDNS name over Ethernet.
PI_HOST=parr.local
PI_USER=george
PI_PROJECT_DIR=/home/george/repos/pi-film-reversal
PI_SSH_PASSWORD=replace-with-the-pi-ssh-password

# The Pi's hotspot. The Stick joins this network; scripts/pi_hotspot.py creates it.
WIFI_SSID=pifilm-cam
WIFI_PASSWORD=replace-with-8-to-63-ascii-characters

# The address the Stick calls. Its host is also the hotspot's own address.
PIFILM_REMOTE_URL=http://10.42.0.1:8765
# Where pifilm-capture listens on the Pi (default 0.0.0.0:8765 if omitted).
PIFILM_LISTEN=0.0.0.0:8765
# The service unit's --ups flag selects the UPS (none or x728); see docs/x728-ups.md.
PIFILM_REMOTE_TOKEN=replace-with-a-long-random-token

# The look the Pi service loads. pifilm/data is the bundled starter preset and is
# present in every checkout. A trained model lives under artifacts/ (gitignored)
# and must be copied to the Pi first, e.g. .../artifacts/personal-collection-01-v1.
PI_ARTIFACT_DIR=/home/george/repos/pi-film-reversal/pifilm/data

# Nextcloud photo sync (scripts/nextcloud_sync.py). Pushes ~/Pictures/pifilm into
# one Nextcloud folder over WebDAV from the Pi, but only when the wired LAN is
# up. Use a Nextcloud app password (Settings > Security > Devices & sessions),
# never your login password. TARGET_DIR is the folder created on Nextcloud;
# SOURCE_DIR defaults to ~/Pictures/pifilm if left blank.
NEXTCLOUD_URL=http://192.168.178.241:8083/
NEXTCLOUD_USER=george
NEXTCLOUD_PASSWORD=replace-with-a-nextcloud-app-password
NEXTCLOUD_TARGET_DIR=RaspberryPi
NEXTCLOUD_SOURCE_DIR=/home/george/Pictures/pifilm
